# Vigzone AI — Groq Production v2
# Copy this file to .env for local testing. In production, set these in your host's Variables panel.
# Never commit a real .env with real API keys.

AI_PROVIDER=groq
APP_MODE=production
ENV=production

# Groq hosted chat backend
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Voice message transcription fallback
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional: comma-separated fallback models if the main model is rate-limited/down.
GROQ_BACKUP_MODELS=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Per-user daily app limits and countdown
DAILY_TOKEN_LIMIT=100000
BYOK_DAILY_TOKEN_LIMIT=100000
ENFORCE_DEFAULT_DAILY_LIMIT=true
ENFORCE_BYOK_DAILY_LIMIT=true
USAGE_RESERVE_TOKENS=800
USAGE_TZ_OFFSET_MINUTES=330

# Token saving / history compaction
MAX_HISTORY_MESSAGES=14
MAX_COMPACTED_TURNS=18
MAX_COMPACT_MESSAGE_CHARS=700

# Safety
CHAT_RATE_LIMIT_PER_MINUTE=20
COOKIE_SECURE=true
ENCRYPTION_SECRET=change_this_to_a_long_random_secret
ADMIN_EMAILS=

# Optional auth / Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Real-time data/search settings
WEB_SEARCH_ENABLED=true
USER_TIMEZONE=Asia/Colombo
WEATHER_DEFAULT_LOCATION=Colombo, Sri Lanka

# Image generation
IMAGE_API_PROVIDER=auto
# OPENAI_API_KEY=your_openai_api_key_here

# Application
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
WORKERS=4
TIMEOUT=120
VIRUS_SCAN_STRICT=false
VIRUS_SCAN_TIMEOUT=30

# Voice transcription language retry priority. Good default for Sri Lanka.
VOICE_TRANSCRIPTION_LANG_PRIORITY=si,ta,en,hi


# High-quality image generation
# auto = OpenAI if OPENAI_API_KEY exists, otherwise Pollinations free fallback
IMAGE_API_PROVIDER=auto
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_BACKGROUND=auto
IMAGE_PROMPT_ENHANCER=auto
IMAGE_PROMPT_ENHANCER_MODEL=llama-3.1-8b-instant
POLLINATIONS_MODEL=flux
POLLINATIONS_ENHANCE=true

# Vigzone Product Suite
VIGZONE_VERSION=v4.0-brain-pro
VIGZONE_DATA_DIR=data


# Living frontend/product config (removes hardcoded UI text)
VIGZONE_APP_NAME=Vigzone AI
VIGZONE_SHORT_NAME=Vigzone AI
VIGZONE_BUILD_NAME=Vigzone Brain Pro Suite
VIGZONE_NEW_CHAT_TOPLINE=Start with a real task
VIGZONE_NEW_CHAT_SUBTITLE=Open a fresh chat for one focused goal. Tell {app_name} what you are trying to finish, attach useful files, or choose a starter below.
VIGZONE_GROQ_HINT=Groq is fast and generous on the free tier — cheaper than most alternatives for a project like this.
VIGZONE_GREETING_OPTIONS=Back at it,|Welcome back,|Good to see you,|Hey there,
GROQ_KEYS_URL=https://console.groq.com/keys
GROQ_DOCS_URL=https://console.groq.com/docs/models
VIGZONE_BACKEND_LABEL=Groq (hosted)

# Do not put placeholder API keys in production. Leave empty until you add a real gsk_ Groq key.
