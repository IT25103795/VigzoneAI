# Vigzone AI 5.0
# Copy to .env for local development. Never commit .env or real credentials.
#
# Production requires:
#   APP_MODE=production
#   COOKIE_SECURE=true
#   VIRUS_SCAN_STRICT=true
#   WORKERS=1
#   a unique 32+ character ENCRYPTION_SECRET
#   a persistent VIGZONE_DATA_DIR
#   explicit HTTPS CORS_ORIGINS and PUBLIC_BASE_URL

# Runtime
APP_MODE=testing
ENV=development
PORT=8000
LOG_LEVEL=INFO
WORKERS=1
VIGZONE_DATA_DIR=data
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
TRUSTED_PROXY_IPS=
ENABLE_API_DOCS=true

# Required AI provider
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BACKUP_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
# Caps backup requests below common free/on-demand TPM ceilings. If Groq
# reports a smaller live limit, Vigzone retries once with a tighter payload.
GROQ_FALLBACK_MAX_REQUEST_TOKENS=7000
GROQ_FALLBACK_MAX_COMPLETION_TOKENS=3200
GROQ_FALLBACK_MIN_COMPLETION_TOKENS=512
GROQ_FALLBACK_RETRY_SAFETY_PERCENT=70
GROQ_ALLOWED_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_ALLOWED_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_FALLBACK_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Encryption, sessions, and admin bootstrap
ENCRYPTION_SECRET=
SESSION_TTL_DAYS=30
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=Vigzone Admin
ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_EMAILS only promotes an already verified account; bootstrap is preferred.
ADMIN_EMAILS=

# Usage and abuse controls
DAILY_TOKEN_LIMIT=100000
BYOK_DAILY_TOKEN_LIMIT=100000
ENFORCE_DEFAULT_DAILY_LIMIT=true
ENFORCE_BYOK_DAILY_LIMIT=true
USAGE_RESERVE_TOKENS=800
USAGE_TZ_OFFSET_MINUTES=330
CHAT_RATE_LIMIT_PER_MINUTE=20
GLOBAL_WRITE_RATE_LIMIT_PER_MINUTE=180
MAX_HISTORY_MESSAGES=14
MAX_COMPACTED_TURNS=18
MAX_COMPACT_MESSAGE_CHARS=700

# Uploads, OCR, and malware scanning
MAX_REQUEST_BODY_BYTES=33554432
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_VOICE_UPLOAD_SIZE_BYTES=26214400
MAX_SOURCE_IMAGE_BYTES=20971520
MAX_GENERATED_IMAGE_BYTES=26214400
MAX_PDF_OCR_PAGES=12
MAX_PDF_TEXT_PAGES=200
OCR_LANGUAGES=eng
VIRUS_SCAN_STRICT=false
VIRUS_SCAN_TIMEOUT=30

# Search and current data
WEB_SEARCH_ENABLED=true
USER_TIMEZONE=Asia/Colombo
WEATHER_DEFAULT_LOCATION=Colombo, Sri Lanka
OPENWEATHER_API_KEY=
ALPHAVANTAGE_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Optional Google sign-in and Drive picker
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_CLIENT_ID=

# Optional transactional email (verification and password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# Image generation: OpenAI when configured, otherwise the labelled Pollinations fallback
IMAGE_API_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_BACKGROUND=auto
IMAGE_PROMPT_ENHANCER=auto
IMAGE_PROMPT_ENHANCER_MODEL=llama-3.1-8b-instant
POLLINATIONS_MODEL=flux
POLLINATIONS_ENHANCE=true

# Product
VIGZONE_VERSION=5.0.0
VIGZONE_APP_NAME=Vigzone AI
VIGZONE_SHORT_NAME=Vigzone AI
VIGZONE_BUILD_NAME=Vigzone AI Production
VIGZONE_BACKEND_LABEL=Groq (hosted)
BRAIN_CLOUD_MAX_BYTES=2000000
CONVERSATION_MAX_BYTES=1000000
SHARE_MAX_BYTES=1000000
MAX_LEARNING_MEMORIES_PER_USER=200
MAX_WORKSPACES_PER_USER=50
MAX_WORKSPACE_NOTES_PER_WORKSPACE=500
MAX_FEEDBACK_PER_USER=5000
MAX_ACTIVE_SHARES_PER_USER=100
MAX_CONVERSATIONS_PER_USER=200
