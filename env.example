# Vigzone AI Configuration
# ========================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — keep it in .gitignore.
#
# This package is Groq-only: no Ollama server, no local model, no GPU required.

# ── Chat backend: Groq hosted API ─────────────────────────────────────────────
# 1. Create a free Groq account + API key at https://console.groq.com/keys
# 2. Paste it into GROQ_API_KEY below or your host's Variables panel
# 3. Redeploy/restart Vigzone
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Usage table / countdown
# Set DAILY_TOKEN_LIMIT to match your Groq plan/model limit.
DAILY_TOKEN_LIMIT=100000
USAGE_TZ_OFFSET_MINUTES=330

# App mode
# testing    → usage tracking off
# production → usage tracked per signed-in user
APP_MODE=production

# Required for saving users' own Groq keys encrypted in the DB
ENCRYPTION_SECRET=change_this_to_a_long_random_secret

# Image generation
IMAGE_API_PROVIDER=pollinations
# OPENAI_API_KEY=your_openai_api_key_here

# Authentication / Google sign-in optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Real-time web/search settings
WEB_SEARCH_ENABLED=true
USER_TIMEZONE=Asia/Colombo
WEATHER_DEFAULT_LOCATION=Colombo, Sri Lanka

# Application
ENV=development
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
WORKERS=4
TIMEOUT=120

# Virus scanning
VIRUS_SCAN_STRICT=false
VIRUS_SCAN_TIMEOUT=30
