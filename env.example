# Vigzone AI — Groq Production v2
# Copy this file to .env for local testing. In production, set these in your host's Variables panel.
# Never commit a real .env with real API keys.

AI_PROVIDER=groq
APP_MODE=production
ENV=production

# Groq hosted chat backend
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# Optional: comma-separated fallback models if the main model is rate-limited/down.
GROQ_BACKUP_MODELS=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Per-user daily app limits and countdown
DAILY_TOKEN_LIMIT=100000
BYOK_DAILY_TOKEN_LIMIT=100000
ENFORCE_DEFAULT_DAILY_LIMIT=true
ENFORCE_BYOK_DAILY_LIMIT=true
USAGE_RESERVE_TOKENS=800
USAGE_TZ_OFFSET_MINUTES=330

# Token saving / history compaction
MAX_HISTORY_MESSAGES=14
MAX_COMPACTED_TURNS=18
MAX_COMPACT_MESSAGE_CHARS=700

# Safety
CHAT_RATE_LIMIT_PER_MINUTE=20
COOKIE_SECURE=true
ENCRYPTION_SECRET=change_this_to_a_long_random_secret
ADMIN_EMAILS=

# Optional auth / Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Real-time data/search settings
WEB_SEARCH_ENABLED=true
USER_TIMEZONE=Asia/Colombo
WEATHER_DEFAULT_LOCATION=Colombo, Sri Lanka

# Image generation
IMAGE_API_PROVIDER=pollinations
# OPENAI_API_KEY=your_openai_api_key_here

# Application
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
WORKERS=4
TIMEOUT=120
VIRUS_SCAN_STRICT=false
VIRUS_SCAN_TIMEOUT=30
