# Vigzone AI Configuration
# ========================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — keep it in .gitignore.

# ── Chat backend: Groq (hosted, default) ──────────────────────────────────────
# One-time setup:
#   1. Create a free account + API key: https://console.groq.com/keys
#   2. Paste it into GROQ_API_KEY below
#   3. That's it — no server to run, no model to download, no GPU needed.
#
# See https://console.groq.com/docs/models for the current model list/names.
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # only change if using a proxy

# ── Chat backend: local Ollama (alternative) ──────────────────────────────────
# Set AI_PROVIDER=ollama above to use this instead of Groq. Needs Ollama
# installed and running on the same machine as this server:
#   1. Install Ollama: https://ollama.com/download
#   2. ollama pull gemma3        (text + vision, 140+ languages incl. Sinhala)
#   3. Ollama starts automatically after install; or run: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
OLLAMA_VISION_MODEL=gemma3

# ── App mode ──────────────────────────────────────────────────────────────────
# testing    → unlimited messages, no token tracking (default for local dev)
# production → token usage tracked per user in SQLite (for worldwide launch)
APP_MODE=testing

# ── Image generation ──────────────────────────────────────────────────────────
# "pollinations" = free, no API key required (default)
# "openai"       = requires OPENAI_API_KEY below
IMAGE_API_PROVIDER=pollinations
# OPENAI_API_KEY=your_openai_api_key_here

# ── Authentication ────────────────────────────────────────────────────────────
# Email/password auth works out of the box (SQLite, no setup needed).
#
# Google sign-in (optional):
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Add redirect URI: http://localhost:8000/api/auth/google/callback
#   4. Fill in the two values below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Real-Time Web Search ──────────────────────────────────────────────────────
# Enables Vigzone to search the web for live info (news, prices, scores, etc.)
# Uses DuckDuckGo — no API key or account required. Requires internet access.
# Set to "false" to disable (Vigzone falls back to model knowledge only).
WEB_SEARCH_ENABLED=true

# ── Real-World Data Access (Weather, Prices, Stocks, Crypto) ──────────────────
# NEW: Multi-source real-world data integration for 100% accuracy.
# 
# Weather (optional — use DuckDuckGo by default):
#   OpenWeather API key (free tier at https://openweathermap.org/api)
#   Enables accurate temperature, humidity, wind, and forecasts
# OPENWEATHER_API_KEY=
#
# Stock/Crypto Prices:
#   CoinGecko (crypto) — FREE, no API key required
#   Yahoo Finance (stocks) — FREE, no API key required
#   AlphaVantage (stocks + crypto) — optional, sign up at https://www.alphavantage.co/
# ALPHAVANTAGE_API_KEY=
#
# Currency Exchange Rates:
#   ExchangeRate-API (free tier) — automatic, no API key required

# Local timezone used for direct date/time answers injected into prompts.
# Use a standard IANA timezone name, for example: Asia/Colombo, Europe/London.
USER_TIMEZONE=Asia/Colombo

# Default place to use when a user asks for weather/forecast without naming a city.
WEATHER_DEFAULT_LOCATION=Colombo, Sri Lanka

# ── Application ───────────────────────────────────────────────────────────────
ENV=development
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
WORKERS=4
TIMEOUT=120

# ── Virus Scanning (ClamAV) ───────────────────────────────────────────────────
# Vigzone scans every uploaded file with ClamAV before processing it.
# Install ClamAV:
#   Ubuntu/Debian:  sudo apt-get install clamav
#   macOS:          brew install clamav
#   Windows:        https://www.clamav.net/downloads
#
# After install, update virus signatures:
#   sudo freshclam            (Linux/macOS)
#
# VIRUS_SCAN_STRICT controls what happens if ClamAV is unavailable:
#   false (default) → warn in logs, allow upload (graceful degradation)
#   true            → block upload if scanner cannot run (maximum security)
VIRUS_SCAN_STRICT=false

# Timeout in seconds for a single file scan (default: 30).
VIRUS_SCAN_TIMEOUT=30
