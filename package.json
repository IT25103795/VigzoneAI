{
  "name": "vigzone-ai-desktop",
  "productName": "Vigzone AI",
  "version": "1.0.2",
  "description": "Vigzone AI desktop host with the always-available Vigi companion.",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron-forge start",
    "desktop:dev": "electron-forge start -- --app-url=http://127.0.0.1:8000/chat",
    "desktop:package": "electron-forge package --platform=win32 --arch=x64",
    "desktop:make": "electron-forge make --platform=win32 --arch=x64",
    "test": "python -m pytest -q"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "electron": "43.2.0",
    "electron-winstaller": "5.4.4"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "yauzl": "3.3.1"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
